FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
      streamlit==1.65.0 \
      requests==2.34.2 \
      pandas==3.0.6

# agent_app.py imports hiring_agent.frontend.api_client, so the package layout is kept
COPY src/hiring_agent/__init__.py ./src/hiring_agent/__init__.py
COPY src/hiring_agent/frontend ./src/hiring_agent/frontend
ENV PYTHONPATH=/app/src

EXPOSE 8501
CMD ["streamlit", "run", "src/hiring_agent/frontend/agent_app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
