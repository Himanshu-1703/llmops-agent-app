FROM python:3.12-slim

# uv (pinned to a rolling minor tag)
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /bin/uv

WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/src

# Dependencies first, in their own layer: a code change doesn't reinstall them.
#   --no-default-groups  only the main dependencies (no eval, frontend or dev packages)
#   --no-install-project don't install hiring_agent as a package (see the code note below)
# The cache mount keeps uv's download cache out of the image.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-default-groups --no-install-project

# Serving code only: no evals, experimentation, utils or tests.
# The code must stay at /app/src/hiring_agent/... because workspace.py and
# parameter_config.py find the project root with Path(__file__).parents[3]; that root
# (/app) is where params.yaml and workspace_app/ live. PYTHONPATH makes it importable.
COPY src/hiring_agent/__init__.py ./src/hiring_agent/__init__.py
COPY src/hiring_agent/api ./src/hiring_agent/api
COPY src/hiring_agent/app ./src/hiring_agent/app
COPY src/hiring_agent/config ./src/hiring_agent/config
COPY params.yaml ./

# Same settings as CI and the local ~/.guardrailsrc: no Guardrails telemetry, and the
# validators run here (they only call Jev and OpenAI).
RUN printf 'enable_metrics=false\nuse_remote_inferencing=false\n' > /root/.guardrailsrc

# No workspace_app/ in the image: api/main.py creates an empty one when the API starts.
EXPOSE 8000
CMD ["uvicorn", "hiring_agent.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
